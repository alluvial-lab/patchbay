      "identity": ["token-commune", "provider_pool", "old"]
    },
    "replacement": {
      "lsn": 2,
      "adapter_generation": 2,
      "retired_identity": ["token-commune", "provider_pool", "old"],
      "replacement_identity": ["token-commune", "provider_pool", "new"]
    },
    "covered_refeed": {
      "lsn": 1,
      "adapter_generation": 1
    },
    "lower_generation_next_candidate": {
      "lsn": 3,
      "adapter_generation": 1
    },
    "sibling_prefix_probe": {
      "lsn": 3,
      "stored_event_kind": "STORED_EVENT_KIND_OBSERVATION"
    },
    "failed_replacement": {
      "lsn": 4,
      "adapter_generation": 2,
      "tombstone_identity": ["token-commune", "provider_pool", "new"],
      "tombstone_from_revision_lsn": 2,
      "paired_upsert_identity": ["token-commune", "provider_pool", "old"],
      "upsert_from_revision_lsn": 2
    },
    "retired_mutation_candidates": ["upsert", "unknown", "tombstone"]
  },
  "expected_outcome": {
    "initial_applied": true,
    "replacement_applied_atomically": true,
    "retired_identity_tombstoned": true,
    "replacement_identity_active": true,
    "covered_refeed_result": "success_no_change",
    "covered_refeed_applied_through_lsn": 2,
    "lower_generation_next_result": "corrupt_log",
    "rejected_candidate_applied_through_lsn": 2,
    "sibling_probe_advanced_prefix": true,
    "sibling_probe_resource_state_unchanged": true,
    "final_applied_through_lsn": 3,
    "failed_replacement_result": "terminal_tombstone",
    "failed_replacement_error_identity": ["token-commune", "provider_pool", "old"],
    "failed_replacement_applied_through_lsn": 3,
    "failed_replacement_full_projection_unchanged": true,
    "failed_replacement_views_unchanged": true,
