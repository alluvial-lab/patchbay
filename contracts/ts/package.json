{
  "name": "@patchbay/contracts",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src/gen"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "gen": "cd .. && buf generate",
    "check:vectors": "node ../scripts/check-vectors.mjs",
    "generate:vectors": "node ../scripts/check-vectors.mjs --write",
    "check:models": "node ../scripts/check-models.mjs",
    "check:drift": "node ../scripts/check-generated-drift.mjs",
    "check:presentation": "node ../scripts/check-presentation.mjs",
    "test:presentation": "node ../scripts/test-presentation-check.mjs"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.12.1"
  },
  "devDependencies": {
    "@bufbuild/protoc-gen-es": "2.12.1",
    "axe-core": "^4.12.1",
    "jsdom": "^26.1.0",
    "typescript": "5.9.3"
  }
}
