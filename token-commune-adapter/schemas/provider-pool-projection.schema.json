{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "patchbay.token_commune.provider_pool.projection.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["provider", "contributionCount", "totalDeclaredShare", "healthCounts", "anonymousContributions", "models", "fingerprint"],
  "properties": {
    "provider": { "type": "string", "minLength": 1 },
    "contributionCount": { "type": "integer", "minimum": 0 },
    "totalDeclaredShare": { "type": "number", "minimum": 0 },
    "healthCounts": {
      "type": "object", "additionalProperties": false, "required": ["fresh", "exhausted", "authBroken"],
      "properties": { "fresh": { "type": "integer", "minimum": 0 }, "exhausted": { "type": "integer", "minimum": 0 }, "authBroken": { "type": "integer", "minimum": 0 } }
    },
    "anonymousContributions": { "type": "array", "items": { "$ref": "provider-pool-payload.schema.json#/$defs/contribution" } },
    "models": { "type": "array", "items": { "$ref": "provider-pool-payload.schema.json#/$defs/model" } },
    "fingerprint": { "$ref": "provider-pool-payload.schema.json#/$defs/fingerprintSummary" }
  }
}
