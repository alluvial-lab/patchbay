{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "patchbay.token_commune.provider_pool.payload.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["identityStrategy", "gatewayDeploymentKey", "provider", "contributionListing", "statusTelemetry", "modelCatalog", "fingerprint", "limitations"],
  "properties": {
    "identityStrategy": { "const": "composite-local" },
    "gatewayDeploymentKey": { "type": "string", "minLength": 1 },
    "provider": { "type": "string", "minLength": 1 },
    "contributionListing": { "$ref": "#/$defs/contributionListing" },
    "statusTelemetry": { "$ref": "#/$defs/statusTelemetry" },
    "modelCatalog": { "$ref": "#/$defs/modelCatalog" },
    "fingerprint": { "$ref": "#/$defs/providerFingerprint" },
    "limitations": {
      "type": "object", "additionalProperties": false,
      "required": ["snapshotCompleteness", "contributorAttribution", "contributionIdentity", "statusPoolJoin", "capacityAggregation"],
      "properties": {
        "snapshotCompleteness": { "const": "partial" },
        "contributorAttribution": { "const": "unavailable" },
        "contributionIdentity": { "const": "snapshot-local-synthesized" },
        "statusPoolJoin": { "const": "unavailable" },
        "capacityAggregation": { "const": "none" }
      }
    }
  },
  "$defs": {
    "health": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["state"], "properties": { "state": { "const": "fresh" } } },
        { "type": "object", "additionalProperties": false, "required": ["state", "exhaustedUntil"], "properties": { "state": { "const": "exhausted" }, "exhaustedUntil": { "type": "string", "format": "date-time" } } },
        { "type": "object", "additionalProperties": false, "required": ["state", "reason"], "properties": { "state": { "const": "auth_broken" }, "reason": { "type": "string", "minLength": 1, "maxLength": 512 } } }
      ]
    },
    "capacity": {
      "type": "object", "additionalProperties": false,
      "required": ["window", "usedFraction", "usedUnits", "limitUnits", "resetsAt", "source", "observedAt"],
      "properties": {
        "window": { "type": "string", "minLength": 1 },
        "usedFraction": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "usedUnits": { "type": ["number", "null"], "minimum": 0 },
        "limitUnits": { "type": ["number", "null"], "minimum": 0 },
        "resetsAt": { "type": ["string", "null"], "format": "date-time" },
        "source": { "enum": ["headers", "usage_endpoint", "observed_429", "declared"] },
        "observedAt": { "type": "string", "format": "date-time" }
      }
    },
    "poolFingerprint": {
      "type": "object", "additionalProperties": false,
      "required": ["state", "templateSource", "since", "diffPresent"],
      "properties": {
        "state": { "enum": ["ok", "held", "unknown"] },
        "templateSource": { "enum": ["compiled", "override"] },
        "since": { "type": ["string", "null"], "format": "date-time" },
        "diffPresent": { "type": "boolean" }
      }
    },
    "anonymousContribution": {
      "type": "object", "additionalProperties": false,
      "required": ["subKey", "subKeySource", "subKeyStability", "attribution", "declaredShare", "health", "telemetryState", "capacityReadings", "fingerprint"],
      "properties": {
        "subKey": { "type": "string", "pattern": "^local:anonymous-contribution:[0-9a-f]{24}:[1-9][0-9]*$" },
        "subKeySource": { "const": "synthesized-content-hash" },
        "subKeyStability": { "const": "snapshot-local" },
        "attribution": { "const": "unavailable" },
        "declaredShare": { "type": "number", "minimum": 0, "maximum": 1 },
        "health": { "$ref": "#/$defs/health" },
        "telemetryState": { "enum": ["readings", "no-readings"] },
        "capacityReadings": { "type": "array", "items": { "$ref": "#/$defs/capacity" } },
        "fingerprint": { "$ref": "#/$defs/poolFingerprint" }
      },
      "oneOf": [
        {
          "properties": {
            "telemetryState": { "const": "no-readings" },
            "capacityReadings": { "type": "array", "maxItems": 0 }
          }
        },
        {
          "properties": {
            "telemetryState": { "const": "readings" },
            "capacityReadings": { "type": "array", "minItems": 1 }
          }
        }
      ]
    },
    "contributionListing": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["status", "contributions"], "properties": { "status": { "const": "reported" }, "contributions": { "type": "array", "items": { "$ref": "#/$defs/anonymousContribution" } } } },
        { "type": "object", "additionalProperties": false, "required": ["status", "contributions"], "properties": { "status": { "const": "not-reported" }, "contributions": { "type": "array", "maxItems": 0 } } },
        { "type": "object", "additionalProperties": false, "required": ["status", "contributions"], "properties": { "status": { "const": "unavailable" }, "contributions": { "type": "array", "maxItems": 0 } } }
      ]
    },
    "statusContribution": {
      "type": "object", "additionalProperties": false,
      "required": ["contributionId", "provider", "readings"],
      "properties": {
        "contributionId": { "type": "string", "minLength": 1 },
        "provider": { "type": "string", "minLength": 1 },
        "readings": { "type": "array", "items": { "$ref": "#/$defs/capacity" } }
      }
    },
    "statusTelemetry": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false,
          "required": ["status", "gatewayOk", "anthropicHealth", "joinability", "contributions"],
          "properties": {
            "status": { "const": "reported" }, "gatewayOk": { "type": "boolean" },
            "anthropicHealth": { "oneOf": [{ "$ref": "#/$defs/health" }, { "type": "null" }] },
            "joinability": { "const": "unjoinable-with-pool-rows" },
            "contributions": { "type": "array", "items": { "$ref": "#/$defs/statusContribution" } }
          }
        },
        { "type": "object", "additionalProperties": false, "required": ["status", "contributions"], "properties": { "status": { "const": "not-reported" }, "contributions": { "type": "array", "maxItems": 0 } } },
        { "type": "object", "additionalProperties": false, "required": ["status", "contributions"], "properties": { "status": { "const": "unavailable" }, "contributions": { "type": "array", "maxItems": 0 } } }
      ]
    },
    "model": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "provider", "surface", "upstreamModel", "contextWindow", "maxTokens", "reasoning", "available"],
      "properties": {
        "id": { "type": "string", "minLength": 1 }, "provider": { "type": "string", "minLength": 1 },
        "surface": { "type": "string", "minLength": 1 }, "upstreamModel": { "type": ["string", "null"] },
        "contextWindow": { "type": "number", "exclusiveMinimum": 0 }, "maxTokens": { "type": "number", "exclusiveMinimum": 0 },
        "reasoning": { "type": "boolean" }, "available": { "type": "boolean" }
      }
    },
    "modelCatalog": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["status", "models"], "properties": { "status": { "const": "reported" }, "models": { "type": "array", "items": { "$ref": "#/$defs/model" } } } },
        { "type": "object", "additionalProperties": false, "required": ["status", "models"], "properties": { "status": { "const": "unavailable" }, "models": { "type": "array", "maxItems": 0 } } }
      ]
    },
    "fingerprintState": {
      "type": "object", "additionalProperties": false,
      "required": ["templateSource", "capturedAt", "capturePresent", "holdReason", "heldAt", "diffPresent"],
      "properties": {
        "templateSource": { "type": ["string", "null"] }, "capturedAt": { "type": ["string", "null"], "format": "date-time" },
        "capturePresent": { "type": "boolean" }, "holdReason": { "type": ["string", "null"] },
        "heldAt": { "type": ["string", "null"], "format": "date-time" }, "diffPresent": { "type": "boolean" }
      }
    },
    "providerFingerprint": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["status", "probe", "value"], "properties": { "status": { "const": "reported" }, "probe": { "enum": ["anthropic", "openai-codex"] }, "value": { "$ref": "#/$defs/fingerprintState" } } },
        { "type": "object", "additionalProperties": false, "required": ["status", "probe", "reason"], "properties": { "status": { "const": "unknown" }, "probe": { "type": ["string", "null"], "enum": ["anthropic", "openai-codex", null] }, "reason": { "enum": ["probe-unavailable", "not-probed"] } } }
      ]
    }
  }
}
