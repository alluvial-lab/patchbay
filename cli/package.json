{
  "name": "patchbay-cli",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "bin": {
    "patchbay-cli": "./dist/src/main.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/main.js",
    "test": "npm run build && node --test dist/tests/*.test.js && npm run test:real-core-resource",
    "test:core-smoke": "npm run build && node tests/core-smoke.mjs",
    "test:real-core-resource": "cargo build --manifest-path ../Cargo.toml -p patchbay-core-server --bin patchbay-core-server && node tests/real-core-resource-projection.mjs"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.12.1",
    "@connectrpc/connect": "2.1.2",
    "@connectrpc/connect-node": "2.1.2",
    "@patchbay/contracts": "file:../contracts/ts",
    "@patchbay/operator-domain": "file:../operator-domain"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22"
  }
}
