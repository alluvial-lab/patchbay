{
  "name": "patchbay-cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "patchbay-cli": "./dist/src/main.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/main.js",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "test:core-smoke": "npm run build && node tests/core-smoke.mjs"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.12.1",
    "@connectrpc/connect": "2.1.2",
    "@connectrpc/connect-node": "2.1.2",
    "@patchbay/contracts": "file:../contracts/ts"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22"
  }
}
